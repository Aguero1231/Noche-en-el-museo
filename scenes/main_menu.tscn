theme_override_colors/font_color = Color(0.85, 0.83, 0.78, 1)
theme_override_constants/line_spacing = 8
text = "WASD — Moverse        Shift — Correr
Mouse — Mirar / cámara
E o clic — Usar, recoger, leer        R — Señuelo (walkie)
C — Cambiar entre primera y tercera persona
F o clic derecho — Linterna        V — Subir / bajar espejo
Esc — Pausa        F11 — Pantalla completa
Las estatuas solo se mueven cuando NO las miras."
horizontal_alignment = 1

